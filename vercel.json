{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/auto-move",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/send-materials",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/directory-lifecycle",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 7 * * *"
    }
  ]
}
